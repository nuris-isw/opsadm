---
// src/pages/index.astro

// --- SETUP SSR (Agar web update real-time) ---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryGroup from '../components/CategoryGroup.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components'; // Kita butuh ini untuk ikon di pesan "Tidak ditemukan"
import "../styles/global.css";

// Import Data
// import links from '../data/links.json';
// Ganti dengan Import Fungsi Sheet
import { getLinksFromSheet } from '../lib/sheet.js';

// Ambil data dari Google Sheet saat halaman dibuka
const links = await getLinksFromSheet();
// ------------------------
---

<MainLayout title="Portal OA | BPH">
	
	<Header 
		title="Portal Divisi Operasional Umum & Administrasi" 
		subtitle="Akses terpusat dokumen, formulir, dan arsip digital internal."
	/>

	<div x-data="{ search: '' }" class="min-h-screen pb-12 px-4 md:px-8">
		
		<SearchBar />

		<div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start max-w-7xl mx-auto">
			
			{links.map((group) => (
				<CategoryGroup 
					category={group.category} 
					icon={group.icon} 
					items={group.items} 
				/>
			))}

			<div 
				x-show="search !== '' && $el.parentElement.querySelectorAll('[data-search]:not([style*=\'display: none\'])').length === 0" 
				class="col-span-full text-center py-20 hidden"
			>
				<div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4">
					<Icon name="mdi:file-search-outline" class="w-8 h-8 text-slate-400" />
				</div>
				<p class="text-slate-500">
					Tidak ada dokumen yang cocok dengan "<span x-text="search" class="font-bold text-slate-700"></span>"
				</p>
				<button 
					@click="search = ''" 
					class="mt-4 text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline transition-colors"
				>
					Bersihkan pencarian
				</button>
			</div>

		</div>

	</div>

	<Footer />

</MainLayout>