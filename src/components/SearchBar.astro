---
// src/components/SearchBar.astro
import { Icon } from 'astro-icon/components';
---

<div class="sticky top-0 z-30 px-6 py-4 md:px-0 md:static md:mb-8 bg-white/95 backdrop-blur-sm md:bg-transparent border-b border-[var(--color-border-subtle)] md:border-none transition-all">
    
    <div class="relative group w-full max-w-3xl mx-auto">
        
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <Icon 
                name="mdi:magnify" 
                class="w-5 h-5 text-slate-400 group-focus-within:text-[var(--color-primary)] transition-colors duration-200" 
            />
        </div>
        
        <input 
            type="text" 
            x-model="search"
            class="block w-full pl-11 pr-10 py-3 text-sm md:text-base bg-white border border-[var(--color-border-subtle)] rounded-lg text-[var(--color-text-main)] placeholder-slate-400 shadow-sm focus:outline-none focus:border-[var(--color-border-strong)] focus:ring-1 focus:ring-[var(--color-border-strong)] transition-all duration-200 ease-in-out" 
            placeholder="Cari dokumen, SOP, arsip, atau formulir..."
            autocomplete="off"
        />
        
        <button 
            type="button"
            x-show="search.length > 0"
            @click="search = ''"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-90"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-100"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-90"
            style="display: none;"
            class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-slate-400 hover:text-[var(--color-primary)] transition-colors focus:outline-none"
            title="Hapus pencarian"
        >
            <Icon name="mdi:close" class="w-5 h-5" />
        </button>

    </div>
</div>