---
// src/components/Header.astro
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="pt-10 pb-8 px-6 text-center border-b border-[var(--color-border-subtle)] bg-white/50 backdrop-blur-sm md:bg-transparent md:border-none transition-colors duration-300">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
        
        <div class="w-24 h-24 mb-6 bg-white rounded-lg flex items-center justify-center border border-[var(--color-border-subtle)] shadow-md hover:border-[var(--color-primary)] hover:shadow-lg transition-all duration-300 group">
            <img 
                src="/logo.png" 
                alt="Logo Divisi Operasional" 
                class="w-16 h-16 object-contain group-hover:scale-105 transition-transform duration-300" 
            />
        </div>

        <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-text-main)] tracking-tight">
            {title}
        </h1>

        <p class="text-[var(--color-text-muted)] mt-3 text-sm md:text-base leading-relaxed max-w-2xl">
            {subtitle}
        </p>
        
        <div class="w-12 h-1 bg-[var(--color-primary)] rounded-full mt-6 opacity-80"></div>
    </div>
</header>