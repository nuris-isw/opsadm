---
// src/components/Header.astro
import { Icon } from 'astro-icon/components';

interface Props {
    title: string;
    subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<header class="pt-12 pb-8 px-6 text-center bg-white md:bg-transparent border-b md:border-none border-slate-100">
    <div class="max-w-4xl mx-auto">
        <div class="w-20 h-20 mx-auto bg-blue-600 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-200 mb-6 rotate-3 hover:rotate-0 transition-transform duration-300">
            <Icon name="mdi:office-building" class="w-10 h-10 text-white" />
        </div>

        <h1 class="text-2xl md:text-4xl font-bold text-slate-900 tracking-tight">
            {title}
        </h1>

        <p class="text-slate-500 mt-3 text-sm md:text-lg leading-relaxed max-w-2xl mx-auto">
            {subtitle}
        </p>
    </div>
</header>