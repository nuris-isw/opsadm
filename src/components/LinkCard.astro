---
// src/components/LinkCard.astro
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  url: string;
  type: string;
  keywords?: string[];
}

const { title, url, type, keywords = [] } = Astro.props;
const searchString = `${title} ${keywords.join(' ')}`.toLowerCase();

const getTypeStyles = (type: string) => {
  switch (type) {
    case 'sheet': return { color: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-100', icon: 'mdi:file-excel' };
    case 'doc': return { color: 'text-blue-700', bg: 'bg-blue-50', border: 'border-blue-100', icon: 'mdi:file-word' };
    case 'pdf': return { color: 'text-rose-700', bg: 'bg-rose-50', border: 'border-rose-100', icon: 'mdi:file-pdf-box' };
    case 'form': return { color: 'text-purple-700', bg: 'bg-purple-50', border: 'border-purple-100', icon: 'mdi:form-select' };
    default: return { color: 'text-gray-600', bg: 'bg-gray-100', border: 'border-gray-200', icon: 'mdi:folder-google-drive' };
  }
};
const style = getTypeStyles(type);
---

<div 
    class="link-card-item group relative flex items-center gap-3 p-3 bg-white border border-[var(--color-border-subtle)] rounded-md hover:border-[var(--color-primary)] hover:shadow-sm transition-all duration-200"
    data-search={searchString}
    x-show="search === '' || $el.dataset.search.includes(search.toLowerCase())"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
>
    
    <div class={`w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-md ${style.bg} ${style.color} border ${style.border}`}>
        <Icon name={style.icon} class="w-6 h-6" />
    </div>

    <a href={url} target="_blank" class="flex-1 min-w-0 focus:outline-none group/text">
        <span class="absolute inset-0" aria-hidden="true"></span>
        <p class="text-sm font-medium text-[var(--color-text-main)] truncate group-hover:text-[var(--color-primary)] transition-colors">
            {title}
        </p>
        <p class="text-xs text-[var(--color-text-muted)] truncate mt-0.5 capitalize flex items-center gap-1">
            {type} 
            <span class="opacity-0 group-hover/text:opacity-100 transition-opacity duration-200 text-[var(--color-primary)] font-semibold">&bull; Buka</span>
        </p>
    </a>

    <div x-data="{ copied: false }" class="relative z-10">
        <button 
            data-url={url}

            @click.stop="
                navigator.clipboard.writeText($el.dataset.url);
                copied = true;
                setTimeout(() => copied = false, 2000);
            " 
            class="p-2 rounded-md transition-colors focus:outline-none focus:ring-1 focus:ring-[var(--color-primary-light)]"
            :class="copied ? 'text-green-600 bg-green-50' : 'text-gray-400 hover:text-[var(--color-primary)] hover:bg-red-50'"
            title="Salin Link"
        >
            <template x-if="copied">
                <Icon name="mdi:check" class="w-4 h-4" />
            </template>
            <template x-if="!copied">
                <Icon name="mdi:content-copy" class="w-4 h-4" />
            </template>
        </button>
    </div>
</div>