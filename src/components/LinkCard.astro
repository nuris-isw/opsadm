---
// src/components/LinkCard.astro
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  url: string;
  type: string;
  keywords?: string[]; // Wajib ada agar tidak error
}

// Default keywords array kosong jika tidak ada data
const { title, url, type, keywords = [] } = Astro.props;

// Gabungkan Title + Keywords menjadi satu string kecil semua untuk pencarian
const searchString = `${title} ${keywords.join(' ')}`.toLowerCase();

// Helper untuk style warna
const getTypeStyles = (type: string) => {
  switch (type) {
    case 'sheet':
      return { 
        color: 'text-green-700', bg: 'bg-green-50', border: 'border-green-200', icon: 'mdi:file-excel' 
      };
    case 'doc':
      return { 
        color: 'text-blue-700', bg: 'bg-blue-50', border: 'border-blue-200', icon: 'mdi:file-word' 
      };
    case 'pdf':
      return { 
        color: 'text-red-700', bg: 'bg-red-50', border: 'border-red-200', icon: 'mdi:file-pdf-box' 
      };
    case 'form':
      return { 
        color: 'text-purple-700', bg: 'bg-purple-50', border: 'border-purple-200', icon: 'mdi:form-select' 
      };
    case 'drive':
    default:
      return { 
        color: 'text-slate-600', bg: 'bg-slate-100', border: 'border-slate-200', icon: 'mdi:folder-google-drive' 
      };
  }
};

const style = getTypeStyles(type);
---

<div 
    class="group relative flex items-center gap-3 p-3 bg-white border border-slate-200 rounded-xl hover:shadow-md hover:border-slate-300 transition-all duration-200"
    data-search={searchString}
    x-show="search === '' || $el.dataset.search.includes(search.toLowerCase())"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
>
    
    <div class={`w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-lg ${style.bg} ${style.color} ${style.border} border`}>
        <Icon name={style.icon} class="w-6 h-6" />
    </div>

    <a href={url} target="_blank" class="flex-1 min-w-0 focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        <p class="text-sm font-medium text-slate-900 truncate group-hover:text-blue-600 transition-colors">
            {title}
        </p>
        <p class="text-xs text-slate-500 truncate mt-0.5 capitalize">
            {type} &bull; Klik untuk buka
        </p>
    </a>

    <button 
        @click.stop="navigator.clipboard.writeText(url); alert('Link berhasil disalin!')" 
        class="relative z-10 p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-full transition-colors"
        title="Salin Link"
    >
        <Icon name="mdi:content-copy" class="w-4 h-4" />
    </button>
</div>