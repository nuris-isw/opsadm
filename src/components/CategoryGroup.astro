---
// src/components/CategoryGroup.astro
import { Icon } from 'astro-icon/components';
import LinkCard from './LinkCard.astro';

interface Props {
  category: string;
  icon: string;
  items: any[];
}

const { category, icon, items } = Astro.props;
---

<div 
    x-data="{ open: true }" 
    class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col h-full"
    x-show="search === '' || $el.querySelectorAll('[data-search]').length > 0 && Array.from($el.querySelectorAll('[data-search]')).some(el => el.style.display !== 'none')"
>
    
    <button 
        @click="open = !open" 
        class="w-full flex items-center justify-between p-4 bg-slate-50 hover:bg-slate-100 transition-colors text-left"
    >
        <div class="flex items-center gap-3">
            <Icon name={icon} class="w-5 h-5 text-slate-500" />
            <h2 class="font-semibold text-slate-700">{category}</h2>
            <span class="text-xs font-medium bg-white text-slate-400 px-2 py-0.5 rounded-full border border-slate-200">
                {items.length}
            </span>
        </div>
        
        <Icon 
            name="mdi:chevron-down" 
            class="w-5 h-5 text-slate-400 transition-transform duration-200"
            :class="open ? 'rotate-180' : ''"
        />
    </button>

    <div x-show="open" x-collapse class="p-4 bg-white border-t border-slate-100">
        <div class="space-y-3">
            {items.map((item) => (
                <LinkCard 
                    title={item.title}
                    url={item.url}
                    type={item.type}
                    keywords={item.keywords} 
                />
            ))}
        </div>
    </div>
</div>