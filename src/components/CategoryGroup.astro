---
// src/components/CategoryGroup.astro
import { Icon } from 'astro-icon/components';
import LinkCard from './LinkCard.astro';

interface Props {
  category: string;
  icon: string;
  items: any[];
}

const { category, icon, items } = Astro.props;
---

<div 
    x-data="{ open: true }" 
    class="bg-white rounded-lg border border-[var(--color-border-subtle)] shadow-sm flex flex-col h-full overflow-hidden hover:shadow-md transition-shadow duration-300"
    /* Logic: Sembunyikan Group ini jika SEMUA anaknya (LinkCard) tersembunyi */
    x-show="search === '' || $el.querySelectorAll('.link-card-item:not([style*=\'display: none\'])').length > 0"
    x-transition.duration.300ms
>
    
    <button 
        @click="open = !open" 
        class="w-full flex items-center justify-between p-4 bg-gray-50/80 hover:bg-gray-100 transition-colors text-left border-b border-[var(--color-border-subtle)]"
    >
        <div class="flex items-center gap-3">
            <Icon name={icon} class="w-5 h-5 text-[var(--color-primary)]" />
            
            <h2 class="font-bold text-[var(--color-text-main)] text-sm md:text-base tracking-tight">
                {category}
            </h2>
            
            <span class="text-xs font-semibold bg-white text-[var(--color-text-muted)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)]">
                {items.length}
            </span>
        </div>
        
        <Icon 
            name="mdi:chevron-down" 
            class="w-5 h-5 text-gray-400 transition-transform duration-200"
            :class="open ? 'rotate-180' : ''"
        />
    </button>

    <div x-show="open" x-collapse class="p-4 bg-white">
        <div class="space-y-3">
            {items.map((item) => (
                <LinkCard 
                    title={item.title}
                    url={item.url}
                    type={item.type}
                    keywords={item.keywords} 
                />
            ))}
        </div>
    </div>
</div>